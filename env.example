# Vdatadao Proof Environment Variables
# Copy this file to .env and update the values

# Database Configuration
DB_TYPE=postgresql
DATABASE_URL=postgresql://vdatadao_user:vdatadao_password@localhost:5432/vdatadao

# PostgreSQL specific settings (used if DATABASE_URL is not set)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vdatadao
POSTGRES_USER=vdatadao_user
POSTGRES_PASSWORD=vdatadao_password

# SQLite fallback (used if DB_TYPE=sqlite)
DB_PATH=data/registry.db

# Docker Configuration
DOCKER_CONTAINER=false

# Application Settings
DLP_ID=143
GOOGLE_TOKEN=your_google_token_here

# Input/Output Directories
INPUT_DIR=/input
OUTPUT_DIR=/output
