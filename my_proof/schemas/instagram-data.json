{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Instagram Data Schema",
  "type": "object",
  "required": ["userId", "username", "exportTimestamp", "profile", "metadata"],
  "properties": {
    "userId": {
      "type": "string",
      "description": "Instagram user identifier",
      "pattern": "^[0-9]+$"
    },
    "username": {
      "type": "string",
      "description": "Instagram username without @ symbol",
      "pattern": "^[a-zA-Z0-9._]{1,30}$"
    },
    "exportTimestamp": {
      "type": "number",
      "description": "Timestamp when data was exported (milliseconds)",
      "minimum": 1000000000000
    },
    "profile": {
      "type": "object",
      "required": ["displayName", "biography", "followerCount", "followingCount", "postCount"],
      "properties": {
        "displayName": {
          "type": "string",
          "description": "Profile display name",
          "maxLength": 150
        },
        "biography": {
          "type": "string",
          "description": "Profile biography/bio",
          "maxLength": 150
        },
        "followerCount": {
          "type": "integer",
          "description": "Number of followers",
          "minimum": 0
        },
        "followingCount": {
          "type": "integer", 
          "description": "Number of accounts following",
          "minimum": 0
        },
        "postCount": {
          "type": "integer",
          "description": "Total number of posts",
          "minimum": 0
        },
        "isVerified": {
          "type": "boolean",
          "description": "Whether account is verified"
        },
        "isPrivate": {
          "type": "boolean",
          "description": "Whether account is private"
        },
        "profilePictureUrl": {
          "type": "string",
          "format": "uri",
          "description": "Profile picture URL"
        },
        "externalUrl": {
          "type": "string",
          "format": "uri",
          "description": "External website link"
        },
        "category": {
          "type": "string",
          "description": "Account category (personal, business, creator)"
        }
      }
    },
    "posts": {
      "type": "array",
      "description": "Array of Instagram posts",
      "items": {
        "type": "object",
        "required": ["postId", "timestamp", "mediaType"],
        "properties": {
          "postId": {
            "type": "string",
            "description": "Unique post identifier"
          },
          "caption": {
            "type": "string",
            "description": "Post caption text",
            "maxLength": 2200
          },
          "timestamp": {
            "type": "number",
            "description": "Post creation timestamp"
          },
          "mediaType": {
            "type": "string",
            "enum": ["image", "video", "carousel"],
            "description": "Type of media content"
          },
          "mediaUrls": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "description": "URLs of media files"
          },
          "hashtags": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^#[a-zA-Z0-9_]+$"
            },
            "description": "Hashtags used in post"
          },
          "mentions": {
            "type": "array", 
            "items": {
              "type": "string",
              "pattern": "^@[a-zA-Z0-9._]+$"
            },
            "description": "User mentions in post"
          },
          "likeCount": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of likes"
          },
          "commentCount": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of comments"
          },
          "shareCount": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of shares"
          },
          "location": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Location name"
              },
              "coordinates": {
                "type": "object",
                "properties": {
                  "latitude": {"type": "number"},
                  "longitude": {"type": "number"}
                }
              }
            }
          }
        }
      }
    },
    "stories": {
      "type": "array",
      "description": "Array of Instagram stories",
      "items": {
        "type": "object",
        "required": ["storyId", "timestamp", "mediaType"],
        "properties": {
          "storyId": {
            "type": "string",
            "description": "Unique story identifier"
          },
          "timestamp": {
            "type": "number",
            "description": "Story creation timestamp"
          },
          "mediaType": {
            "type": "string",
            "enum": ["image", "video"],
            "description": "Type of story media"
          },
          "mediaUrl": {
            "type": "string",
            "format": "uri",
            "description": "Story media URL"
          },
          "viewCount": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of story views"
          },
          "impressions": {
            "type": "integer",
            "minimum": 0,
            "description": "Story impressions"
          },
          "stickers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Stickers used in story"
          }
        }
      }
    },
    "reels": {
      "type": "array",
      "description": "Array of Instagram reels",
      "items": {
        "type": "object",
        "required": ["reelId", "timestamp", "audioInfo"],
        "properties": {
          "reelId": {
            "type": "string",
            "description": "Unique reel identifier"
          },
          "caption": {
            "type": "string",
            "description": "Reel caption",
            "maxLength": 2200
          },
          "timestamp": {
            "type": "number",
            "description": "Reel creation timestamp"
          },
          "mediaUrl": {
            "type": "string",
            "format": "uri",
            "description": "Reel video URL"
          },
          "audioInfo": {
            "type": "object",
            "properties": {
              "trackName": {"type": "string"},
              "artistName": {"type": "string"},
              "isOriginal": {"type": "boolean"}
            }
          },
          "playCount": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of plays"
          },
          "likeCount": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of likes"
          },
          "commentCount": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of comments"
          },
          "shareCount": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of shares"
          },
          "effects": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Effects used in reel"
          }
        }
      }
    },
    "analytics": {
      "type": "object",
      "description": "Instagram analytics and insights",
      "properties": {
        "accountInsights": {
          "type": "object",
          "properties": {
            "reach": {
              "type": "integer",
              "minimum": 0,
              "description": "Total account reach"
            },
            "impressions": {
              "type": "integer", 
              "minimum": 0,
              "description": "Total account impressions"
            },
            "engagementRate": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Overall engagement rate percentage"
            },
            "followerGrowth": {
              "type": "object",
              "properties": {
                "period": {"type": "string"},
                "growthCount": {"type": "integer"},
                "growthPercentage": {"type": "number"}
              }
            }
          }
        },
        "topPosts": {
          "type": "array",
          "description": "Top performing posts",
          "items": {
            "type": "object",
            "properties": {
              "postId": {"type": "string"},
              "engagementScore": {"type": "number"},
              "reach": {"type": "integer"},
              "impressions": {"type": "integer"}
            }
          }
        },
        "audienceInsights": {
          "type": "object",
          "properties": {
            "demographics": {
              "type": "object",
              "properties": {
                "genderDistribution": {
                  "type": "object",
                  "properties": {
                    "male": {"type": "number"},
                    "female": {"type": "number"},
                    "other": {"type": "number"}
                  }
                },
                "ageGroups": {
                  "type": "object",
                  "properties": {
                    "13-17": {"type": "number"},
                    "18-24": {"type": "number"},
                    "25-34": {"type": "number"},
                    "35-44": {"type": "number"},
                    "45-54": {"type": "number"},
                    "55-64": {"type": "number"},
                    "65+": {"type": "number"}
                  }
                },
                "topLocations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "country": {"type": "string"},
                      "percentage": {"type": "number"}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["source", "exportMethod", "dataVersion"],
      "properties": {
        "source": {
          "type": "string",
          "enum": ["instagram_official_export", "instagram_api", "third_party_tool"],
          "description": "Source of the data export"
        },
        "exportMethod": {
          "type": "string",
          "description": "Method used to export data"
        },
        "dataVersion": {
          "type": "string",
          "description": "Version of the data format"
        },
        "exportDate": {
          "type": "string",
          "format": "date-time",
          "description": "Date when data was exported"
        },
        "fileCount": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of files in the export"
        },
        "totalMediaSize": {
          "type": "integer",
          "minimum": 0,
          "description": "Total size of media files in bytes"
        },
        "privacySettings": {
          "type": "object",
          "properties": {
            "dataRetentionDays": {"type": "integer"},
            "includesDeletedContent": {"type": "boolean"},
            "includesDirectMessages": {"type": "boolean"}
          }
        }
      }
    }
  }
} 